# StudioBench 配置示例。复制到本机私有位置（不要提交到仓库），按需修改后：
#     set -a; source ~/studio.env; set +a
# 密钥（STUDIO_TOKEN、H3_TOKEN、STUDIO_SEARCH_API_KEY 等）只在 shell 里 export，
# 不要写进仓库文件。run 时含 TOKEN/KEY/SECRET/PASSWORD 的变量会走 0600 临时文件交给 MCP server，
# 不会写进 mcp.json。

# ---------------------------------------------------------------- 被测模型（Claude Code 侧）
STUDIO_MODEL=claude-opus-5-5
STUDIO_BASE_URL=http://127.0.0.1:8788            # Anthropic 兼容网关 / 本地代理
STUDIO_AUTH=api-key                              # api-key → ANTHROPIC_API_KEY；bearer → ANTHROPIC_AUTH_TOKEN
# STUDIO_TOKEN=...                               # 网关令牌，只 export
STUDIO_EFFORT=max                                # CLAUDE_CODE_EFFORT_LEVEL，同一批次内保持一致
STUDIO_RUNS_DIR=./runs                           # 运行产物目录，默认 <cwd>/runs

# ---------------------------------------------------------------- MCP server 解释器
# 需要 torch / diffusers / transformers / Pillow（真实模型后端时）
# STUDIO_PYTHON=<ENV_DIR>/bin/python
# STUDIO_CUDA_COMPAT=<cuda-compat 目录>           # 宿主驱动比 torch 的 CUDA 旧时必须给

# ---------------------------------------------------------------- 视频：MiniMax-H3（vllm-omni）
H3_ENDPOINT=http://127.0.0.1:30020               # fl2va 服务：t2v + i2v
H3_REF2VA_ENDPOINT=http://127.0.0.1:30021        # ref2va 服务：ref_video（另一份权重，单独起）
# H3_TOKEN=...                                   # 服务开了 --api-key 时
# H3_MAX_WAIT=3600                               # 单段最长等待秒数

# ---------------------------------------------------------------- 本地模型根目录（可选）
# 若干后端会用 STUDIO_MODELS_ROOT / STUDIO_SHARE 下的默认路径；不配置则这些后端标记为不可用，
# 只跑 mock 不需要任何模型。
# STUDIO_MODELS_ROOT=/path/to/models
# STUDIO_SHARE=/path/to/studio-share

# ---------------------------------------------------------------- 图像
# QWEN_IMAGE_PATH=/path/to/Qwen-Image
QWEN_IMAGE_EDIT_PATH=                            # 推荐 Qwen-Image-Edit-2509（支持 ref 参考图）
# STUDIO_IMAGE_OFFLOAD=model                     # model（默认，和 H3 共卡）| sequential | none

# ---------------------------------------------------------------- 声音
STUDIO_TTS_BACKEND=qwen3-tts                     # qwen3-tts（默认）| cosyvoice3（回退/对照）
# STUDIO_QWENTTS_PYTHON=/path/to/python
# STUDIO_QWENTTS_ROOT=/path/to/Qwen3-TTS
STUDIO_TTS_SPEAKER=Serena                        # Vivian / Serena / Uncle_Fu / Dylan / Eric / Ryan / Aiden / Ono_Anna / Sohee
# STUDIO_TTS_INSTRUCT=                           # 全局默认语气
# STUDIO_TTS_LANGUAGE=Auto                       # Auto | Chinese | English | ...
STUDIO_TTS_PERSISTENT=1                          # 常驻 worker：加载后每句更快

# tts 回退后端：CosyVoice3（只有 STUDIO_TTS_BACKEND=cosyvoice3 才用）
# STUDIO_COSYVOICE_PYTHON=/path/to/python
# STUDIO_COSYVOICE_REPO=/path/to/CosyVoice
# STUDIO_COSYVOICE_MODEL=/path/to/CosyVoice3-0.5B
# STUDIO_TTS_PROMPT_WAV=$STUDIO_COSYVOICE_REPO/asset/zero_shot_prompt.wav
# STUDIO_TTS_PROMPT_TEXT=希望你以后能够做的比我还好呦。

# sfx：MMAudio（子进程跑官方 demo.py）
# STUDIO_MMAUDIO_PYTHON=/path/to/python
# STUDIO_MMAUDIO_REPO=/path/to/MMAudio
# STUDIO_MMAUDIO_WEIGHTS=/path/to/MMAudio-weights
STUDIO_MMAUDIO_VARIANT=large_44k_v2
# STUDIO_HF_CACHE=/path/to/hf_cache               # DFN5B CLIP、BigVGAN 放这里

# music / lipsync：按 JSON argv 模板接入
# STUDIO_MUSIC_CMD=["<python>", "<脚本>", "--prompt", "{prompt}", "--duration", "{duration}", "--lyrics-file", "{lyrics_file}", "--output", "{output}"]
# STUDIO_MUSIC_NAME=ace-step
# STUDIO_LIPSYNC_CMD=["<python>", "<脚本>", "--video", "{video}", "--audio", "{audio}", "--output", "{output}"]
# STUDIO_LIPSYNC_NAME=latentsync

# asr：Belle-whisper（MCP server 进程内，要 transformers）
# STUDIO_ASR_MODEL=/path/to/Belle-whisper-large-v3-zh

# ---------------------------------------------------------------- 检索
# 默认 bing：免 key，先 RSS、空包退回 HTML；出网按需配置代理。
STUDIO_SEARCH_PROVIDER=bing
# STUDIO_SEARCH_PROXY=http://127.0.0.1:3128
# STUDIO_SEARCH_MKT=                             # 传 zh-CN 可能把地名带偏
# STUDIO_SEARCH_URL=https://google.serper.dev/search
# STUDIO_SEARCH_API_KEY=...                      # 只 export
# STUDIO_SEARCH_KEY_HEADER=X-API-KEY

# ---------------------------------------------------------------- 字幕字体
# 默认 DroidSansFallback；没有时按系统字体或 STUDIO_FONT_FILE 查找
# STUDIO_FONT_FILE=/path/to/DroidSansFallback.ttf

# ---------------------------------------------------------------- 测试用
# STUDIO_BACKEND=mock                            # 所有生成工具走占位实现（结果标记为无效）。正式跑不要设
